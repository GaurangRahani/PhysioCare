# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/physiocare

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Email (Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Clinic Info (used by public /api/clinic/info endpoint)
# No table needed — admin's phone/email is the clinic contact
CLINIC_NAME=PhysioCare Clinic
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
